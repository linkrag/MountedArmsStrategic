<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Loaded only on RimWorld 1.6 (LoadFolders), while Bin/1.6 is the lot 10 DLL: it has no per-missile
	     scatter (Verb_ShootGuidedCE.ShiftTarget), and CE locks the burst to the first rocket's aim, so a larger
	     circularError would only move the whole salvo. Delete this folder once Bin/1.6 is rebuilt. -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="MAS_Gun_MLRS"]/verbs/li/circularError</xpath>
		<value>
			<circularError>2</circularError>
		</value>
	</Operation>

</Patch>
