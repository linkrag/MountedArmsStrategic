<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ================================================================= -->
	<!--  Tactical ballistic missile (ATACMS / Iskander class).            -->
	<!--  Projectile rules learned on Mounted Arms' rocket battery:        -->
	<!--  - speed 0: ProjectileCE.Launch flies at Max(charge, def speed),  -->
	<!--    so any def speed above the charge breaks the aim;              -->
	<!--  - gravityFactor 5: charges 30/50/70/90 assume mortar gravity.    -->
	<!--  shellingProps.damage is divided by the target faction tech level -->
	<!--  (Industrial 4, Spacer 5, Ultra 6) and rolled x0.4..1.5 by CE;    -->
	<!--  1.5 takes about 3 hits to raze an industrial settlement.         -->
	<!-- ================================================================= -->

	<CombatExtended.AmmoCategoryDef>
		<defName>MAS_TacticalMissileHE</defName>
		<label>tactical missile (HE)</label>
		<labelShort>HE</labelShort>
		<description>Unitary high-explosive warhead for a tactical ballistic missile.</description>
	</CombatExtended.AmmoCategoryDef>

	<CombatExtended.AmmoSetDef>
		<defName>MAS_AmmoSet_TacticalMissile</defName>
		<label>tactical ballistic missiles</label>
		<ammoTypes>
			<MAS_Ammo_TacticalMissile_HE>MAS_Bullet_TacticalMissile_HE</MAS_Ammo_TacticalMissile_HE>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="HeavyAmmoBase">
		<defName>MAS_Ammo_TacticalMissile_HE</defName>
		<label>tactical ballistic missile (HE)</label>
		<description>A short-range ballistic missile with inertial and satellite guidance and a unitary high-explosive warhead. Fired from a tactical missile launcher at the local map or at settlements on the world map.</description>
		<graphicData>
			<texPath>MountedArmsStrategic/TacticalMissile_Item</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>800</Mass>
			<Bulk>2000</Bulk>
			<MarketValue>3200</MarketValue>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoMissiles</li>
		</thingCategories>
		<stackLimit>4</stackLimit>
		<cookOffFlashScale>40</cookOffFlashScale>
		<cookOffSound>MortarBomb_Explode</cookOffSound>
		<ammoClass>MAS_TacticalMissileHE</ammoClass>
		<detonateProjectile>MAS_Bullet_TacticalMissile_HE</detonateProjectile>
	</ThingDef>

	<!-- ================== Projectile ================== -->

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>MAS_Bullet_TacticalMissile_HE</defName>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<label>tactical ballistic missile (HE)</label>
		<description>A tactical ballistic missile in flight.</description>
		<graphicData>
			<texPath>MountedArmsStrategic/TacticalMissile_Projectile</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>(1.5,3)</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>0</speed>
			<gravityFactor>5</gravityFactor>
			<flyOverhead>true</flyOverhead>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>1500</damageAmountBase>
			<explosionRadius>9.9</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<preExplosionSpawnSingleThingDef>CraterLarge</preExplosionSpawnSingleThingDef>
			<soundExplode>Explosion_GiantBomb</soundExplode>
			<soundHitThickRoof>Explosion_GiantBomb</soundHitThickRoof>
			<soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
			<soundAmbient>RocketPropelledLoop_Big</soundAmbient>
			<dropsCasings>false</dropsCasings>
			<shellingProps>
				<iconPath>Things/WorldObjects/Munitions/Rocket</iconPath>
				<tilesPerTick>0.4</tilesPerTick>
				<range>120</range>
				<damage>1.5</damage>
			</shellingProps>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>20</Fragment_Large>
					<Fragment_Small>30</Fragment_Small>
				</fragments>
			</li>
			<li Class="CombatExtended.CompProperties_ProjectileFleck">
				<FleckDatas>
					<li>
						<fleck>Fleck_CERocketFlame</fleck>
						<emissionsPerTick>3</emissionsPerTick>
						<flecksPerEmission>3</flecksPerEmission>
						<scale>2</scale>
						<cutoffTickRange>100~150</cutoffTickRange>
						<originOffset>1.5</originOffset>
					</li>
					<li>
						<fleck>Fleck_CERocketSmokeTrail</fleck>
						<emissionsPerTick>2</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>3</scale>
						<flecksPerEmission>1</flecksPerEmission>
					</li>
				</FleckDatas>
			</li>
		</comps>
	</ThingDef>

	<!-- ==================== Recipe ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<!-- CE ammo injector looks the recipe up as "Make" + ammo defName -->
		<defName>MakeMAS_Ammo_TacticalMissile_HE</defName>
		<label>make tactical ballistic missile (HE)</label>
		<description>Assemble a single tactical ballistic missile with a high-explosive warhead.</description>
		<jobString>Assembling a tactical ballistic missile.</jobString>
		<researchPrerequisite>MAS_Research_TacticalMissiles</researchPrerequisite>
		<workAmount>60000</workAmount>
		<skillRequirements>
			<Crafting>8</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter><thingDefs><li>Steel</li></thingDefs></filter>
				<count>300</count>
			</li>
			<li>
				<filter><thingDefs><li>Plasteel</li></thingDefs></filter>
				<count>20</count>
			</li>
			<li>
				<filter><thingDefs><li>FSX</li></thingDefs></filter>
				<count>120</count>
			</li>
			<li>
				<filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter>
				<count>6</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Plasteel</li>
				<li>FSX</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<MAS_Ammo_TacticalMissile_HE>1</MAS_Ammo_TacticalMissile_HE>
		</products>
	</RecipeDef>

</Defs>
