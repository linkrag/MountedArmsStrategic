<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ================================================================= -->
	<!--  Land-attack cruise missile (Tomahawk class), own defs: CE's      -->
	<!--  Tomahawk projectile has no shellingProps, so it cannot fly on    -->
	<!--  the world map. Long reach (400 tiles) but slow (0.15 tiles/tick, -->
	<!--  subsonic); very precise (launcher circularError 1); world damage -->
	<!--  3. Cheaper than an ICBM.                                         -->
	<!-- ================================================================= -->

	<CombatExtended.AmmoCategoryDef>
		<defName>MAS_CruiseMissileHE</defName>
		<label>cruise missile (HE)</label>
		<labelShort>HE</labelShort>
		<description>Subsonic land-attack cruise missile with a unitary high-explosive warhead.</description>
	</CombatExtended.AmmoCategoryDef>

	<CombatExtended.AmmoSetDef>
		<defName>MAS_AmmoSet_CruiseMissile</defName>
		<label>cruise missiles</label>
		<ammoTypes>
			<MAS_Ammo_CruiseMissile>MAS_Bullet_CruiseMissile</MAS_Ammo_CruiseMissile>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="HeavyAmmoBase">
		<defName>MAS_Ammo_CruiseMissile</defName>
		<label>cruise missile</label>
		<description>A subsonic land-attack cruise missile in its launch canister. Slow, but very precise and with a very long reach on the world map.</description>
		<graphicData>
			<texPath>MountedArmsStrategic/CruiseMissile_Item</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>1400</Mass>
			<Bulk>3500</Bulk>
			<MarketValue>5000</MarketValue>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoMissiles</li>
		</thingCategories>
		<stackLimit>4</stackLimit>
		<cookOffFlashScale>40</cookOffFlashScale>
		<cookOffSound>Explosion_GiantBomb</cookOffSound>
		<ammoClass>MAS_CruiseMissileHE</ammoClass>
		<detonateProjectile>MAS_Bullet_CruiseMissile</detonateProjectile>
	</ThingDef>

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>MAS_Bullet_CruiseMissile</defName>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<label>cruise missile</label>
		<description>A cruise missile in flight.</description>
		<graphicData>
			<texPath>MountedArmsStrategic/CruiseMissile_Projectile</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>(2,3)</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>0</speed>
			<gravityFactor>5</gravityFactor>
			<flyOverhead>true</flyOverhead>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>1200</damageAmountBase>
			<explosionRadius>7.9</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<preExplosionSpawnSingleThingDef>CraterLarge</preExplosionSpawnSingleThingDef>
			<soundExplode>Explosion_GiantBomb</soundExplode>
			<soundHitThickRoof>Explosion_GiantBomb</soundHitThickRoof>
			<soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
			<soundAmbient>RocketPropelledLoop_Big</soundAmbient>
			<dropsCasings>false</dropsCasings>
			<shellingProps>
				<iconPath>Things/WorldObjects/Munitions/Rocket</iconPath>
				<tilesPerTick>0.15</tilesPerTick>
				<range>400</range>
				<damage>3</damage>
			</shellingProps>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>20</Fragment_Large>
					<Fragment_Small>40</Fragment_Small>
				</fragments>
			</li>
			<li Class="CombatExtended.CompProperties_ProjectileFleck">
				<FleckDatas>
					<li>
						<fleck>Fleck_CERocketFlame</fleck>
						<emissionsPerTick>2</emissionsPerTick>
						<flecksPerEmission>2</flecksPerEmission>
						<scale>1.5</scale>
						<cutoffTickRange>60~100</cutoffTickRange>
						<originOffset>1</originOffset>
					</li>
					<li>
						<fleck>Fleck_CERocketSmokeTrail</fleck>
						<emissionsPerTick>2</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>2</scale>
						<flecksPerEmission>1</flecksPerEmission>
					</li>
				</FleckDatas>
			</li>
		</comps>
	</ThingDef>

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeMAS_Ammo_CruiseMissile</defName>
		<label>make cruise missile</label>
		<description>Assemble a land-attack cruise missile in its launch canister.</description>
		<jobString>Assembling a cruise missile.</jobString>
		<researchPrerequisite>MAS_Research_CruiseMissiles</researchPrerequisite>
		<workAmount>120000</workAmount>
		<skillRequirements>
			<Crafting>9</Crafting>
		</skillRequirements>
		<ingredients>
			<li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>400</count></li>
			<li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>60</count></li>
			<li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>100</count></li>
			<li><filter><thingDefs><li>FSX</li></thingDefs></filter><count>150</count></li>
			<li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>8</count></li>
			<li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>1</count></li>
		</ingredients>
		<fixedIngredientFilter><thingDefs><li>Steel</li><li>Plasteel</li><li>Chemfuel</li><li>FSX</li><li>ComponentIndustrial</li><li>ComponentSpacer</li></thingDefs></fixedIngredientFilter>
		<products><MAS_Ammo_CruiseMissile>1</MAS_Ammo_CruiseMissile></products>
	</RecipeDef>

</Defs>
